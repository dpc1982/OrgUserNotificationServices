{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "catalogueAssignmentId": {
      "type": "string",
      "prefix": "ca-",
      "key": "Primary",
      "keyLength": 12,
      "readOnly": true,
      "description": "System primary key, framework convention."
    },
    "orgId": {
      "type": "string",
      "description": "Reference to the assigned Organization."
    },
    "catalogueId": {
      "type": "string",
      "description": "Reference to the assigned catalogue."
    },
    "catalogueName": {
      "type": "string",
      "description": "Reference name to the assigned catalogue."
    }
  },
  "required": [
    "orgId",
    "catalogueId"
  ]
}